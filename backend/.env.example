APP_NAME=IgniteStock
APP_ENV=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ignite_stock
MYSQL_USER=ignite_stock
MYSQL_PASSWORD=change-me
DATABASE_URL=mysql+asyncmy://ignite_stock:change-me@localhost:3306/ignite_stock
DATABASE_SYNC_URL=mysql+pymysql://ignite_stock:change-me@localhost:3306/ignite_stock

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
