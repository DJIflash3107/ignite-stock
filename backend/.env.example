APP_NAME=IgniteStock
APP_ENV=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ignite_stock
MYSQL_USER=ignite_stock
MYSQL_PASSWORD=change-me
DATABASE_URL=mysql+asyncmy://ignite_stock:change-me@localhost:3306/ignite_stock
DATABASE_SYNC_URL=mysql+pymysql://ignite_stock:change-me@localhost:3306/ignite_stock

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Sectors Financial API v2
SECTORS_API_BASE_URL=https://api.sectors.app
SECTORS_API_KEY=
SECTORS_API_TIMEOUT_SECONDS=10
SECTORS_API_CACHE_TTL_SECONDS=300

# AI Agent (OpenAI / OpenRouter)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
AGENT_LLM_MODEL=openai/gpt-4o-mini
AGENT_LLM_TEMPERATURE=0.1
